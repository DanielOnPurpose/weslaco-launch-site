<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weslaco Business Owners: Get a FREE Website — Paid by the City's Grant | Triggers Media</title>
<meta name="description" content="Own a Weslaco business with no website? The EDC Marketing Grant pays the full $1,000 for a professional one-page website. One 4-hour visit. Zero out of pocket. Built by Triggers Media.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Comfortaa:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#00689D; --clint:#198FC7; --jade:#27A84A; --bolt:#F99B1C; --bandida:#ED3693;
  --ink:#15303f; --paper:#FFFFFF; --mist:#EAECF5;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Comfortaa',sans-serif;color:var(--ink);background:var(--paper);line-height:1.65;font-size:16px}
h1,h2,h3,.bebas{font-family:'Bebas Neue',sans-serif;letter-spacing:.05em;font-weight:400;line-height:1.05}
img{max-width:100%}
a{color:var(--clint)}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.btn{display:inline-block;padding:16px 34px;border-radius:50px;font-family:'Comfortaa',sans-serif;font-weight:700;font-size:15px;text-decoration:none;cursor:pointer;border:none;transition:transform .15s ease, box-shadow .15s ease}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.18)}
.btn-bolt{background:var(--bolt);color:#fff}
.btn-blue{background:var(--blue);color:#fff}
.btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.7)}
.tag{display:inline-block;background:var(--mist);color:var(--blue);font-weight:700;font-size:12px;padding:6px 16px;border-radius:30px;letter-spacing:.12em;text-transform:uppercase}

/* NAV */
nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);box-shadow:0 1px 0 rgba(0,0,0,.07)}
.nav-in{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;max-width:1180px;margin:0 auto}
.nav-in img{height:34px;width:auto;display:block}
.nav-right{display:flex;align-items:center;gap:14px}
.lang-toggle{display:flex;border:2px solid var(--blue);border-radius:30px;overflow:hidden;font-size:12px;font-weight:700}
.lang-toggle button{border:none;background:transparent;color:var(--blue);padding:7px 14px;cursor:pointer;font-family:'Comfortaa',sans-serif;font-weight:700}
.lang-toggle button.active{background:var(--blue);color:#fff}
.nav-call{font-weight:700;font-size:14px;color:var(--blue);text-decoration:none;white-space:nowrap}
.nav-cta{padding:10px 22px;font-size:13px}
@media(max-width:640px){.nav-call{display:none}}

/* HERO */
.hero{background:linear-gradient(150deg,var(--blue) 0%,#024e75 55%,#063A53 100%);color:#fff;padding:84px 0 110px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-140px;top:-140px;width:480px;height:480px;border:54px solid rgba(255,255,255,.06);border-radius:24px;transform:rotate(18deg)}
.hero .wrap{position:relative;z-index:2}
.hero .tag{background:rgba(255,255,255,.14);color:#fff}
.hero h1{font-size:clamp(44px,7vw,84px);margin:22px 0 8px;color:#fff}
.hero h1 .pop{color:var(--bolt)}
.hero p.sub{font-size:clamp(16px,2.2vw,20px);max-width:640px;opacity:.92;margin-bottom:34px}
.hero .cta-row{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.hero .micro{margin-top:18px;font-size:13px;opacity:.75}
.price-flag{display:inline-flex;align-items:baseline;gap:14px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);padding:14px 22px;border-radius:14px;margin:0 0 30px}
.price-flag .was{text-decoration:line-through;opacity:.65;font-size:20px}
.price-flag .now{font-family:'Bebas Neue',sans-serif;font-size:44px;color:var(--bolt);letter-spacing:.04em}
.price-flag .why{font-size:12.5px;max-width:230px;opacity:.9;line-height:1.45}
.me-check{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 26px}
.me-item{background:rgba(255,255,255,.12);border:1.5px solid rgba(255,255,255,.35);padding:10px 18px;border-radius:40px;font-size:14px;font-weight:700}
.me-item.gold{background:var(--bolt);border-color:var(--bolt);color:#fff}

/* TRUST BAR */
.trust{background:var(--mist);padding:26px 0}
.trust .wrap{display:flex;flex-wrap:wrap;gap:10px 34px;align-items:center;justify-content:center}
.trust span{font-weight:700;font-size:13px;color:#5b6b78;letter-spacing:.06em;text-transform:uppercase}
.trust .tb-label{color:var(--blue)}

/* PROBLEM */
.problem{padding:90px 0 70px}
.grid2{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
@media(max-width:820px){.grid2{grid-template-columns:1fr}}
.problem h2{font-size:clamp(34px,4.5vw,52px);color:var(--blue);margin-bottom:18px}
.problem p{margin-bottom:14px}
.phone-mock{background:var(--ink);border-radius:36px;padding:14px;max-width:300px;margin:0 auto;box-shadow:0 30px 60px rgba(2,78,117,.25)}
.phone-screen{background:#fff;border-radius:26px;overflow:hidden;font-size:12.5px}
.ps-head{background:#f1f3f4;padding:14px 14px 10px}
.ps-head .search{background:#fff;border-radius:30px;padding:8px 14px;color:#666;box-shadow:0 1px 3px rgba(0,0,0,.15)}
.ps-biz{padding:14px}
.ps-biz .name{font-weight:700;font-size:15px}
.ps-biz .stars{color:#f4b400;letter-spacing:2px;font-size:13px;margin:2px 0 8px}
.ps-actions{display:flex;gap:8px;padding:0 14px 16px}
.ps-actions div{flex:1;text-align:center;border:1.5px solid #dadce0;border-radius:20px;padding:7px 4px;color:var(--clint);font-weight:700;font-size:11.5px}
.ps-actions .missing{border-style:dashed;color:#b00020;background:#fff5f5}
.callout{background:#FFF4E3;border-left:5px solid var(--bolt);padding:16px 20px;border-radius:0 12px 12px 0;font-size:14.5px;margin-top:22px}

/* PACKAGE */
.package{background:linear-gradient(180deg,#fff 0%,var(--mist) 100%);padding:80px 0 90px}
.sec-head{text-align:center;max-width:680px;margin:0 auto 54px}
.sec-head h2{font-size:clamp(36px,4.5vw,56px);color:var(--blue);margin:14px 0 12px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px}
.card{background:#fff;border-radius:18px;padding:30px 26px;box-shadow:0 8px 26px rgba(2,78,117,.08);border-top:6px solid var(--clint)}
.card:nth-child(2){border-top-color:var(--jade)}
.card:nth-child(3){border-top-color:var(--bolt)}
.card:nth-child(4){border-top-color:var(--bandida)}
.card:nth-child(5){border-top-color:var(--blue)}
.card .num{font-family:'Bebas Neue',sans-serif;font-size:42px;color:var(--mist);-webkit-text-stroke:1.5px var(--clint);line-height:1}
.card-cta{background:linear-gradient(150deg,var(--blue),#063A53);border-top-color:var(--bolt) !important;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:4px}
.card-cta .cta-big{font-family:'Bebas Neue',sans-serif;font-size:38px;color:#fff;letter-spacing:.04em;line-height:1}
.card-cta .cta-zero{font-family:'Bebas Neue',sans-serif;font-size:38px;color:var(--bolt);letter-spacing:.04em;line-height:1.05}
.card-cta p{color:rgba(255,255,255,.85) !important;margin:10px 0 16px}
.card-cta .btn{font-size:13.5px;padding:13px 24px}
.card:nth-child(2) .num{-webkit-text-stroke-color:var(--jade)}
.card:nth-child(3) .num{-webkit-text-stroke-color:var(--bolt)}
.card:nth-child(4) .num{-webkit-text-stroke-color:var(--bandida)}
.card:nth-child(5) .num{-webkit-text-stroke-color:var(--blue)}
.card h3{font-size:24px;margin:10px 0 8px;color:var(--ink)}
.card p{font-size:14px;color:#46586a}

/* PROCESS */
.process{padding:90px 0}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;counter-reset:step}
.step{position:relative;padding:28px 22px 10px;border-top:4px solid var(--mist)}
.step .dot{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:22px;color:#fff;margin-bottom:14px}
.step:nth-child(1) .dot{background:var(--clint)} .step:nth-child(2) .dot{background:var(--jade)}
.step:nth-child(3) .dot{background:var(--bolt)} .step:nth-child(4) .dot{background:var(--bandida)}
.step h3{font-size:22px;margin-bottom:6px}
.step p{font-size:14px;color:#46586a}
.step .eta{display:inline-block;margin-top:10px;font-size:11.5px;font-weight:700;color:var(--blue);background:var(--mist);border-radius:20px;padding:4px 12px}

/* GRANT */
.grant{background:var(--blue);color:#fff;padding:90px 0}
.grant h2{font-size:clamp(36px,4.5vw,56px);margin-bottom:16px}
.grant .grid2{align-items:start}
.grant p{opacity:.93;margin-bottom:14px;font-size:15.5px}
.check-card{background:#fff;color:var(--ink);border-radius:18px;padding:34px 30px;box-shadow:0 24px 60px rgba(0,0,0,.25)}
.check-card h3{color:var(--blue);font-size:26px;margin-bottom:16px}
.check-card ul{list-style:none}
.check-card li{padding:9px 0 9px 36px;position:relative;font-size:14.5px;border-bottom:1px dashed #e4e8f0}
.check-card li:last-child{border-bottom:none}
.check-card li::before{content:"✓";position:absolute;left:0;top:8px;width:24px;height:24px;border-radius:50%;background:var(--jade);color:#fff;font-size:13px;display:flex;align-items:center;justify-content:center;font-weight:700}
.grant .edc-note{font-size:13px;background:rgba(255,255,255,.1);border-radius:12px;padding:14px 18px;margin-top:8px}

/* TESTIMONIAL */
.testi{padding:90px 0;text-align:center}
.testi blockquote{font-size:clamp(19px,2.6vw,26px);max-width:820px;margin:0 auto 22px;color:var(--ink);font-weight:600}
.testi blockquote .hl{color:var(--clint)}
.testi cite{font-style:normal;font-weight:700;color:var(--blue);font-size:14px;letter-spacing:.08em;text-transform:uppercase}
.testi .quotemark{font-family:'Bebas Neue',sans-serif;font-size:110px;color:var(--bolt);line-height:.4;display:block;margin-bottom:26px}

/* FORM */
.lead{background:linear-gradient(150deg,#063A53,#024e75);padding:90px 0;color:#fff}
.lead .grid2{align-items:center}
.lead h2{font-size:clamp(36px,5vw,58px);margin-bottom:14px}
.lead p{opacity:.9;margin-bottom:16px}
.urgency{display:flex;gap:12px;align-items:flex-start;background:rgba(249,155,28,.14);border:1px solid rgba(249,155,28,.45);padding:14px 18px;border-radius:12px;font-size:14px;margin-top:8px}
.urgency b{color:var(--bolt)}
form{background:#fff;border-radius:20px;padding:38px 34px;color:var(--ink);box-shadow:0 30px 70px rgba(0,0,0,.35)}
form h3{font-size:26px;color:var(--blue);margin-bottom:4px}
form .formsub{font-size:13px;color:#5b6b78;margin-bottom:22px}
.field{margin-bottom:16px}
.field label{display:block;font-size:12.5px;font-weight:700;margin-bottom:6px;color:#33475b}
.field input,.field select{width:100%;padding:13px 16px;border:1.5px solid #d4dbe6;border-radius:10px;font-family:'Comfortaa',sans-serif;font-size:14px;color:var(--ink);background:#fbfcfe}
.field input:focus,.field select:focus{outline:none;border-color:var(--clint);box-shadow:0 0 0 3px rgba(25,143,199,.15)}
form .btn{width:100%;font-size:16px;margin-top:6px}
form .privacy{font-size:11px;color:#8a97a5;margin-top:12px;text-align:center}
.thanks{display:none;text-align:center;padding:30px 10px}
.thanks .big{font-family:'Bebas Neue',sans-serif;font-size:40px;color:var(--jade)}

/* FOOTER */
footer{background:var(--ink);color:#aebccb;padding:54px 0 30px;font-size:13.5px}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;margin-bottom:34px}
@media(max-width:720px){.foot-grid{grid-template-columns:1fr}}
footer img{height:30px;margin-bottom:14px;filter:brightness(0) invert(1);opacity:.9}
footer h4{font-family:'Bebas Neue',sans-serif;color:#fff;font-size:18px;letter-spacing:.08em;margin-bottom:12px}
footer a{color:#cfe3f1;text-decoration:none}
footer a:hover{color:var(--bolt)}
footer ul{list-style:none}
footer li{margin-bottom:8px}
.foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:22px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:12px}
.tagline-foot{font-family:'Bebas Neue',sans-serif;letter-spacing:.18em;color:var(--clint);font-size:15px}

/* sticky mobile call bar */
.mob-bar{display:none;position:fixed;bottom:0;left:0;right:0;z-index:60;background:#fff;box-shadow:0 -4px 18px rgba(0,0,0,.15);padding:10px 14px;gap:10px}
.mob-bar a{flex:1;text-align:center;padding:13px 6px;border-radius:40px;font-weight:700;font-size:14px;text-decoration:none}
.mob-bar .c1{background:var(--blue);color:#fff}
.mob-bar .c2{background:var(--bolt);color:#fff}
@media(max-width:640px){.mob-bar{display:flex}body{padding-bottom:66px}}
</style>
</head>
<body>

<nav>
  <div class="nav-in">
    <a href="#top"><img src="data:image/png;base64," alt="Triggers Media"></a>
    <div class="nav-right">
      <div class="lang-toggle" role="group" aria-label="Language">
        <button id="btn-en" class="active" onclick="setLang('en')">EN</button>
        <button id="btn-es" onclick="setLang('es')">ES</button>
      </div>
      <a class="nav-call" href="tel:9566054321">956-605-4321</a>
      <a class="btn btn-bolt nav-cta" href="#apply" data-en="Check My Eligibility" data-es="Verificar Elegibilidad">Check My Eligibility</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap">
    <span class="tag" data-en="📢 Attention Weslaco Business Owners" data-es="📢 Atención Dueños de Negocios de Weslaco">📢 Attention Weslaco Business Owners</span>
    <h1>
      <span data-en="Hey Weslaco —" data-es="Oye Weslaco —">Hey Weslaco —</span><br>
      <span class="pop" data-en="want a FREE website?" data-es="¿quieres un sitio web GRATIS?">want a FREE website?</span>
    </h1>
    <p class="sub" data-en="Not a gimmick. The City of Weslaco's grant pays the full $1,000 — we build your website, the EDC pays us, and you pay nothing. If your business is on Google without a website, this was made for you." data-es="No es truco. El subsidio de la Ciudad de Weslaco paga los $1,000 completos — nosotros construimos tu sitio, el EDC nos paga, y tú no pagas nada. Si tu negocio está en Google sin sitio web, esto se hizo para ti.">Not a gimmick. The City of Weslaco's grant pays the full $1,000 — we build your website, the EDC pays us, and you pay nothing. If your business is on Google without a website, this was made for you.</p>
    <div class="me-check">
      <div class="me-item" data-en="✓ I own a business in Weslaco" data-es="✓ Tengo un negocio en Weslaco">✓ I own a business in Weslaco</div>
      <div class="me-item" data-en="✓ I don't have a website" data-es="✓ No tengo sitio web">✓ I don't have a website</div>
      <div class="me-item gold" data-en="✓ I'll take a free one" data-es="✓ Sí quiero uno gratis">✓ I'll take a free one</div>
    </div>
    <div class="price-flag">
      <span class="was">$1,000</span>
      <span class="now" data-en="$0 OUT OF POCKET" data-es="$0 DE TU BOLSILLO">$0 OUT OF POCKET</span>
      <span class="why" data-en="The Weslaco EDC grant pays Triggers Media directly. You never write a check." data-es="El subsidio del EDC de Weslaco le paga directamente a Triggers Media. Tú nunca pagas nada.">The Weslaco EDC grant pays Triggers Media directly. You never write a check.</span>
    </div>
    <div class="cta-row">
      <a class="btn btn-bolt" href="#apply" data-en="That's Me — I Want One →" data-es="Ese Soy Yo — Quiero Uno →">That's Me — I Want One →</a>
      <a class="btn btn-ghost" href="tel:9566054321" data-en="Call / Text 956-605-4321" data-es="Llama / Texto 956-605-4321">Call / Text 956-605-4321</a>
    </div>
    <p class="micro" data-en="Takes 60 seconds. No commitment. Grant funds are limited and first come, first served." data-es="Toma 60 segundos. Sin compromiso. Los fondos del subsidio son limitados — primero en llegar, primero en ser atendido.">Takes 60 seconds. No commitment. Grant funds are limited and first come, first served.</p>
  </div>
</header>

<div class="trust">
  <div class="wrap">
    <span class="tb-label" data-en="Trusted by:" data-es="Confían en nosotros:">Trusted by:</span>
    <span>DHR Health</span><span>UTRGV</span><span>McAllen ISD</span><span>RGV College</span><span>RGV Partnership</span><span>HKC Law Firm</span>
  </div>
</div>

<section class="problem">
  <div class="wrap grid2">
    <div>
      <span class="tag" data-en="The Problem" data-es="El Problema">The Problem</span>
      <h2 data-en="An invisible storefront on the busiest street in town" data-es="Un local invisible en la calle más transitada del pueblo">An invisible storefront on the busiest street in town</h2>
      <p data-en="Google is where Weslaco looks first — for tacos, tires, haircuts, flowers, everything. Your listing shows up. But without a website behind it, there's nowhere to see your work, your menu, your prices, or your story. Most people keep scrolling to a business they CAN see." data-es="Google es donde Weslaco busca primero — tacos, llantas, cortes de pelo, flores, todo. Tu negocio aparece. Pero sin un sitio web, no hay dónde ver tu trabajo, tu menú, tus precios o tu historia. La mayoría sigue buscando hasta encontrar un negocio que SÍ pueden ver.">Google is where Weslaco looks first — for tacos, tires, haircuts, flowers, everything. Your listing shows up. But without a website behind it, there's nowhere to see your work, your menu, your prices, or your story. Most people keep scrolling to a business they CAN see.</p>
      <p data-en="Google also ranks businesses with linked websites higher in local search. No website doesn't just lose the click — it buries the listing." data-es="Además, Google posiciona más arriba a los negocios con sitio web. No tener sitio no solo pierde el clic — entierra tu perfil.">Google also ranks businesses with linked websites higher in local search. No website doesn't just lose the click — it buries the listing.</p>
      <div class="callout" data-en="We checked: 100+ Weslaco businesses are on Google right now with no website linked. If that's you, this page is your fix — and the City pays for it." data-es="Lo comprobamos: más de 100 negocios de Weslaco están en Google ahora mismo sin sitio web. Si ese es tu caso, esta página es la solución — y la Ciudad la paga.">We checked: 100+ Weslaco businesses are on Google right now with no website linked. If that's you, this page is your fix — and the City pays for it.</div>
    </div>
    <div class="phone-mock" aria-hidden="true">
      <div class="phone-screen">
        <div class="ps-head"><div class="search">🔍 <span data-en="best shop near me" data-es="mejor negocio cerca de mí">best shop near me</span></div></div>
        <div class="ps-biz">
          <div class="name" data-en="Your Business" data-es="Tu Negocio">Your Business</div>
          <div class="stars">★★★★★ <span style="color:#666;font-size:11px">4.8 (212)</span></div>
        </div>
        <div class="ps-actions">
          <div data-en="Call" data-es="Llamar">Call</div>
          <div data-en="Directions" data-es="Cómo llegar">Directions</div>
          <div class="missing" data-en="Website ✕" data-es="Sitio web ✕">Website ✕</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="package" id="package">
  <div class="wrap">
    <div class="sec-head">
      <span class="tag" data-en="The Weslaco Launch Package" data-es="El Paquete Weslaco Launch">The Weslaco Launch Package</span>
      <h2 data-en="One visit. One page. Your business, finally on the web." data-es="Una visita. Una página. Tu negocio, por fin en la web.">One visit. One page. Your business, finally on the web.</h2>
      <p data-en="Everything below is included in the $1,000 package — the exact amount the Weslaco EDC grant covers." data-es="Todo lo siguiente está incluido en el paquete de $1,000 — exactamente lo que cubre el subsidio del EDC de Weslaco.">Everything below is included in the $1,000 package — the exact amount the Weslaco EDC grant covers.</p>
    </div>
    <div class="cards">
      <div class="card">
        <div class="num">01</div>
        <h3 data-en="4-Hour On-Site Onboarding" data-es="Onboarding de 4 Horas en tu Negocio">4-Hour On-Site Onboarding</h3>
        <p data-en="One visit, everything handled. We interview you, learn your business — history, customers, services — and capture the photos and short video clips for your site. You don't prepare a thing." data-es="Una visita y nos encargamos de todo. Te entrevistamos, conocemos tu negocio — historia, clientes, servicios — y tomamos las fotos y videos cortos para tu sitio. No tienes que preparar nada.">One visit, everything handled. We interview you, learn your business — history, customers, services — and capture the photos and short video clips for your site. You don't prepare a thing.</p>
      </div>
      <div class="card">
        <div class="num">02</div>
        <h3 data-en="One-Page Professional Website" data-es="Sitio Web Profesional de Una Página">One-Page Professional Website</h3>
        <p data-en="Mobile-first and built to convert: your story, services, photos and clips, hours, map, and a tap-to-call button. Just like this page." data-es="Diseñado para celular y para convertir: tu historia, servicios, fotos y videos, horario, mapa y botón de llamada directa. Igual que esta página.">Mobile-first and built to convert: your story, services, photos and clips, hours, map, and a tap-to-call button. Just like this page.</p>
      </div>
      <div class="card">
        <div class="num">03</div>
        <h3 data-en="Google Listing Connection" data-es="Conexión con tu Perfil de Google">Google Listing Connection</h3>
        <p data-en="We link the new site to your Google Business Profile, so the customers already searching for you finally have somewhere to land." data-es="Conectamos el sitio nuevo a tu Perfil de Negocio de Google, para que los clientes que ya te buscan por fin tengan a dónde llegar.">We link the new site to your Google Business Profile, so the customers already searching for you finally have somewhere to land.</p>
      </div>
      <div class="card">
        <div class="num">04</div>
        <h3 data-en="Launch Guide" data-es="Guía de Lanzamiento">Launch Guide</h3>
        <p data-en="A plain-English playbook to get the most from your site — plus the before/after Google numbers the EDC asks for. We handle that paperwork." data-es="Una guía sencilla para sacarle el máximo a tu sitio — más los datos de antes/después que pide el EDC. Nosotros nos encargamos del papeleo.">A plain-English playbook to get the most from your site — plus the before/after Google numbers the EDC asks for. We handle that paperwork.</p>
      </div>
      <div class="card">
        <div class="num">05</div>
        <h3 data-en="One Round of Edits" data-es="Una Ronda de Cambios">One Round of Edits</h3>
        <p data-en="Review the draft, send us your notes in one list, and we polish it before launch. Extra pages or features? We'll quote those separately." data-es="Revisa el borrador, mándanos tus notas en una sola lista y lo pulimos antes del lanzamiento. ¿Páginas o funciones extra? Te cotizamos aparte.">Review the draft, send us your notes in one list, and we polish it before launch. Extra pages or features? We'll quote those separately.</p>
      </div>
      <div class="card card-cta">
        <div class="cta-big" data-en="All of this." data-es="Todo esto.">All of this.</div>
        <div class="cta-zero" data-en="$0 out of pocket." data-es="$0 de tu bolsillo.">$0 out of pocket.</div>
        <p data-en="The Weslaco EDC grant covers the full $1,000. Funds are first come, first served." data-es="El subsidio del EDC de Weslaco cubre los $1,000 completos. Los fondos son por orden de llegada.">The Weslaco EDC grant covers the full $1,000. Funds are first come, first served.</p>
        <a class="btn btn-bolt" href="#apply" data-en="That's Me — I Want One →" data-es="Ese Soy Yo — Quiero Uno →">That's Me — I Want One →</a>
      </div>
    </div>
  </div>
</section>

<section class="process">
  <div class="wrap">
    <div class="sec-head">
      <span class="tag" data-en="How It Works" data-es="Cómo Funciona">How It Works</span>
      <h2 data-en="From grant to launch in four steps" data-es="Del subsidio al lanzamiento en cuatro pasos">From grant to launch in four steps</h2>
    </div>
    <div class="steps">
      <div class="step">
        <div class="dot">1</div>
        <h3 data-en="Check & Apply" data-es="Verifica y Aplica">Check &amp; Apply</h3>
        <p data-en="We confirm your eligibility with the Weslaco EDC and prepare your application and quote — we fill out most of it for you." data-es="Confirmamos tu elegibilidad con el EDC de Weslaco y preparamos tu solicitud y cotización — llenamos casi todo por ti.">We confirm your eligibility with the Weslaco EDC and prepare your application and quote — we fill out most of it for you.</p>
        <span class="eta" data-en="~1 week" data-es="~1 semana">~1 week</span>
      </div>
      <div class="step">
        <div class="dot">2</div>
        <h3 data-en="Board Approval" data-es="Aprobación de la Junta">Board Approval</h3>
        <p data-en="The EDC board reviews applications every third Wednesday of the month. Once approved, the grant pays Triggers Media directly." data-es="La junta del EDC revisa solicitudes el tercer miércoles de cada mes. Al aprobarse, el subsidio le paga directamente a Triggers Media.">The EDC board reviews applications every third Wednesday of the month. Once approved, the grant pays Triggers Media directly.</p>
        <span class="eta" data-en="Monthly board meeting" data-es="Junta mensual">Monthly board meeting</span>
      </div>
      <div class="step">
        <div class="dot">3</div>
        <h3 data-en="The 4-Hour Visit" data-es="La Visita de 4 Horas">The 4-Hour Visit</h3>
        <p data-en="We come to you: interview, business deep-dive, photos, and video clips — all in one session at your shop." data-es="Vamos a tu negocio: entrevista, conocemos tu empresa, fotos y videos — todo en una sola sesión.">We come to you: interview, business deep-dive, photos, and video clips — all in one session at your shop.</p>
        <span class="eta" data-en="1 visit, 4 hours" data-es="1 visita, 4 horas">1 visit, 4 hours</span>
      </div>
      <div class="step">
        <div class="dot">4</div>
        <h3 data-en="Build & Launch" data-es="Construcción y Lanzamiento">Build &amp; Launch</h3>
        <p data-en="We build the site, you review it, we apply your round of edits, connect it to Google, and launch — well inside the grant's 90-day window." data-es="Construimos el sitio, lo revisas, aplicamos tu ronda de cambios, lo conectamos a Google y lo lanzamos — dentro de los 90 días del subsidio.">We build the site, you review it, we apply your round of edits, connect it to Google, and launch — well inside the grant's 90-day window.</p>
        <span class="eta" data-en="Live within 90 days" data-es="En línea en 90 días">Live within 90 days</span>
      </div>
    </div>
  </div>
</section>

<section class="grant" id="grant">
  <div class="wrap grid2">
    <div>
      <span class="tag" style="background:rgba(255,255,255,.14);color:#fff" data-en="The Grant, Explained" data-es="El Subsidio, Explicado">The Grant, Explained</span>
      <h2 data-en="Yes — the City really pays for it" data-es="Sí — la Ciudad realmente lo paga">Yes — the City really pays for it</h2>
      <p data-en="The Weslaco Business Marketing Grant gives eligible businesses up to $1,000 for new marketing — including website design, photography, and video. The EDC pays the marketing provider directly, so you never come out of pocket." data-es="El Subsidio de Marketing para Negocios de Weslaco otorga hasta $1,000 a negocios elegibles para marketing nuevo — incluyendo diseño de sitios web, fotografía y video. El EDC le paga directamente al proveedor de marketing, así que tú nunca pagas de tu bolsillo.">The Weslaco Business Marketing Grant gives eligible businesses up to $1,000 for new marketing — including website design, photography, and video. The EDC pays the marketing provider directly, so you never come out of pocket.</p>
      <p data-en="Don't take our word for it — call the Economic Development Corporation of Weslaco at 956-969-0838 and ask about the Business Marketing Grant." data-es="No confíes solo en nuestra palabra — llama a la Corporación de Desarrollo Económico de Weslaco al 956-969-0838 y pregunta por el Business Marketing Grant.">Don't take our word for it — call the Economic Development Corporation of Weslaco at 956-969-0838 and ask about the Business Marketing Grant.</p>
      <div class="edc-note" data-en="Heads up: grant funds are limited, renewed yearly, and awarded until they run out. Each business can receive it once every 5 years. Applications are due two weeks before the monthly board meeting." data-es="Importante: los fondos son limitados, se renuevan cada año y se otorgan hasta agotarse. Cada negocio puede recibirlo una vez cada 5 años. Las solicitudes vencen dos semanas antes de la junta mensual.">Heads up: grant funds are limited, renewed yearly, and awarded until they run out. Each business can receive it once every 5 years. Applications are due two weeks before the monthly board meeting.</div>
    </div>
    <div class="check-card">
      <h3 data-en="You likely qualify if you're:" data-es="Probablemente calificas si eres:">You likely qualify if you're:</h3>
      <ul>
        <li data-en="A for-profit business with a storefront in Weslaco city limits or ETJ" data-es="Un negocio con fines de lucro y local físico en Weslaco o su ETJ">A for-profit business with a storefront in Weslaco city limits or ETJ</li>
        <li data-en="20 employees or fewer" data-es="Con 20 empleados o menos">20 employees or fewer</li>
        <li data-en="On Google (an active Google Business Profile — we'll help you check)" data-es="En Google (un Perfil de Negocio activo — te ayudamos a verificarlo)">On Google (an active Google Business Profile — we'll help you check)</li>
        <li data-en="In good standing with the City and the State of Texas" data-es="Al corriente con la Ciudad y el Estado de Texas">In good standing with the City and the State of Texas</li>
        <li data-en="A first-timer — no Weslaco marketing grant in the past 5 years" data-es="Primera vez — sin subsidio de marketing de Weslaco en los últimos 5 años">A first-timer — no Weslaco marketing grant in the past 5 years</li>
      </ul>
      <p style="font-size:12px;color:#8a97a5;margin-top:14px" data-en="Some businesses aren't eligible (attorneys, medical practices, daycares, insurance agents, franchises, big-box, non-profits, home-based). Not sure? Ask us — it's a 60-second check." data-es="Algunos negocios no son elegibles (abogados, consultorios médicos, guarderías, agentes de seguros, franquicias, grandes cadenas, sin fines de lucro, negocios desde casa). ¿No estás seguro? Pregúntanos — toma 60 segundos.">Some businesses aren't eligible (attorneys, medical practices, daycares, insurance agents, franchises, big-box, non-profits, home-based). Not sure? Ask us — it's a 60-second check.</p>
    </div>
  </div>
</section>

<section class="testi">
  <div class="wrap">
    <span class="quotemark">&ldquo;</span>
    <blockquote>
      <span data-en="Triggers Media was fantastic to work with! They took the time to sit with me and " data-es="¡Trabajar con Triggers Media fue fantástico! Se tomaron el tiempo de sentarse conmigo y ">Triggers Media was fantastic to work with! They took the time to sit with me and </span><span class="hl" data-en="build my website from scratch. They helped me create the content and media" data-es="construir mi sitio web desde cero. Me ayudaron a crear el contenido y los medios">build my website from scratch. They helped me create the content and media</span><span data-en=" for the website. I highly recommend using their services!" data-es=" para el sitio. ¡Recomiendo mucho sus servicios!"> for the website. I highly recommend using their services!</span>
    </blockquote>
    <cite>— CJ Treviño, CT Prime Real Estate</cite>
  </div>
</section>

<section class="lead" id="apply">
  <div class="wrap grid2">
    <div>
      <h2 data-en="Claim your spot before the grant money runs out" data-es="Aparta tu lugar antes de que se acaben los fondos">Claim your spot before the grant money runs out</h2>
      <p data-en="Tell us about your business and we'll check your eligibility, confirm grant availability with the EDC, and prepare your application — free, no commitment." data-es="Cuéntanos de tu negocio y verificamos tu elegibilidad, confirmamos la disponibilidad del subsidio con el EDC y preparamos tu solicitud — gratis y sin compromiso.">Tell us about your business and we'll check your eligibility, confirm grant availability with the EDC, and prepare your application — free, no commitment.</p>
      <div class="urgency">
        <span style="font-size:20px">⏳</span>
        <span data-en="Grant funds are first come, first served — and the board only meets once a month. The sooner you apply, the sooner you launch." data-es="Los fondos se otorgan por orden de llegada — y la junta solo se reúne una vez al mes. Entre más pronto apliques, más pronto lanzas."><b data-en="Grant funds are first come, first served" data-es="Los fondos se otorgan por orden de llegada">Grant funds are first come, first served</b><span data-en=" — and the board only meets once a month. The sooner you apply, the sooner you launch." data-es=" — y la junta solo se reúne una vez al mes. Entre más pronto apliques, más pronto lanzas."> — and the board only meets once a month. The sooner you apply, the sooner you launch.</span></span>
      </div>
      <p style="margin-top:26px" data-en="Prefer to talk? Call or text Daniel:" data-es="¿Prefieres hablar? Llama o manda texto a Daniel:">Prefer to talk? Call or text Daniel:</p>
      <a class="btn btn-bolt" href="tel:9566054321">956-605-4321</a>
    </div>
    <!-- LEAD FORM: replace YOUR_FORM_ID with your Formspree (or similar) endpoint.
         Until then, submissions open the visitor's email app addressed to daniel@triggers.media. -->
    <form id="leadform" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
      <h3 data-en="Free Eligibility Check" data-es="Verificación Gratis de Elegibilidad">Free Eligibility Check</h3>
      <p class="formsub" data-en="60 seconds. We reply within one business day." data-es="60 segundos. Respondemos en un día hábil.">60 seconds. We reply within one business day.</p>
      <div class="field"><label for="f-name" data-en="Your Name" data-es="Tu Nombre">Your Name</label><input id="f-name" name="name" required placeholder="Maria Garcia"></div>
      <div class="field"><label for="f-biz" data-en="Business Name" data-es="Nombre del Negocio">Business Name</label><input id="f-biz" name="business" required placeholder="Maria's Bakery"></div>
      <div class="field"><label for="f-phone" data-en="Phone" data-es="Teléfono">Phone</label><input id="f-phone" name="phone" type="tel" required placeholder="956-555-1234"></div>
      <div class="field"><label for="f-type" data-en="Type of Business" data-es="Tipo de Negocio">Type of Business</label>
        <select id="f-type" name="type">
          <option data-en="Restaurant / Food" data-es="Restaurante / Comida">Restaurant / Food</option>
          <option data-en="Auto / Tires" data-es="Auto / Llantas">Auto / Tires</option>
          <option data-en="Salon / Barber" data-es="Salón / Barbería">Salon / Barber</option>
          <option data-en="Retail / Boutique" data-es="Tienda / Boutique">Retail / Boutique</option>
          <option data-en="Other" data-es="Otro">Other</option>
        </select>
      </div>
      <button class="btn btn-blue" type="submit" data-en="Check My Eligibility →" data-es="Verificar Mi Elegibilidad →">Check My Eligibility →</button>
      <p class="privacy" data-en="No spam, ever. We only use this to check your grant eligibility." data-es="Nunca enviamos spam. Solo usamos esto para verificar tu elegibilidad.">No spam, ever. We only use this to check your grant eligibility.</p>
      <div class="thanks" id="thanks">
        <span class="big" data-en="You're on the list!" data-es="¡Estás en la lista!">You're on the list!</span>
        <p data-en="We'll call you within one business day." data-es="Te llamamos en un día hábil.">We'll call you within one business day.</p>
      </div>
    </form>
  </div>
</section>

