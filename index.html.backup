<script>
function setLang(lang){
  document.documentElement.lang = lang;
  document.querySelectorAll('[data-en]').forEach(el=>{
    const v = el.getAttribute('data-'+lang);
    if (v !== null) el.textContent = v;
  });
  document.getElementById('btn-en').classList.toggle('active', lang==='en');
  document.getElementById('btn-es').classList.toggle('active', lang==='es');
  try{ localStorage.setItem('tm-lang', lang); }catch(e){}
}
try{ const saved = localStorage.getItem('tm-lang'); if(saved==='es') setLang('es'); }catch(e){}

// Form: if Formspree ID not configured, fall back to a mailto so leads still arrive.
document.getElementById('leadform').addEventListener('submit', function(e){
  const f = this;
  if (f.action.includes('YOUR_FORM_ID')) {
    e.preventDefault();
    const body = encodeURIComponent(
      'New Weslaco Launch lead:\n\nName: '+f.name.value+'\nBusiness: '+f.business.value+'\nPhone: '+f.phone.value+'\nType: '+f.type.value);
    window.location.href = 'mailto:daniel@triggers.media?subject=Weslaco%20Launch%20Lead%20-%20'+encodeURIComponent(f.business.value)+'&body='+body;
    f.querySelectorAll('.field, button, .privacy, h3, .formsub').forEach(el=>el.style.display='none');
    document.getElementById('thanks').style.display='block';
  }
});
</script>
</body>
</html>
